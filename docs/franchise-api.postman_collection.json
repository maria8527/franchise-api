        {
          "name": "08 - Get franchise detail",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "const detail = pm.response.json();",
                  "pm.test(\"Franchise has 2 branches\", function () { pm.expect(detail.branches.length).to.eql(2); });",
                  "const branch1 = detail.branches.find(function (b) { return b.id === pm.collectionVariables.get(\"branchId\"); });",
                  "pm.test(\"Branch 1 has 2 products\", function () { pm.expect(branch1.products.length).to.eql(2); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/franchises/{{franchiseId}}",
