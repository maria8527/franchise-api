{
  "info": {
    "name": "franchise-api",
    "description": "Run the whole collection with the Collection Runner (in order). Requests in folder 1 create the data and save the ids as collection variables; folder 2 checks the error responses. To test a deployed API, change the baseUrl variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Main flow",
      "item": [
        {
          "name": "01 - Create franchise",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test(\"Response has an id and the name\", function () { pm.expect(body.id).to.be.a(\"string\"); pm.expect(body.name).to.eql(\"Juan Valdez Café\"); });",
                  "pm.collectionVariables.set(\"franchiseId\", body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/franchises",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "franchises"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Juan Valdez Café\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
