        {
          "name": "09 - Get top stock products",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "const items = pm.response.json();",
                  "pm.test(\"One top product per branch\", function () { pm.expect(items.length).to.eql(2); });",
                  "const first = items.find(function (i) { return i.branchId === pm.collectionVariables.get(\"branchId\"); });",
                  "pm.test(\"Branch 1 top product is Capuchino (35)\", function () { pm.expect(first.productName).to.eql(\"Capuchino\"); pm.expect(first.stock).to.eql(35); });",
                  "const second = items.find(function (i) { return i.branchId === pm.collectionVariables.get(\"branchId2\"); });",
                  "pm.test(\"Branch 2 top product is Brownie (12)\", function () { pm.expect(second.productName).to.eql(\"Brownie\"); pm.expect(second.stock).to.eql(12); });"
                ]
              }
            }
